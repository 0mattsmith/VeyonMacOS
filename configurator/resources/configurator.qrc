        <file alias="scalable/veyon-config-service.png">icons/modern/veyon-config-service.png</file>
        <file alias="scalable/veyon-config-master.png">icons/modern/veyon-config-master.png</file>
        <file alias="scalable/veyon-config-access-control.png">icons/modern/veyon-config-access-control.png</file>
    </qresource>
    <qresource prefix="/icons/veyon-monochrome">
        <file alias="scalable/veyon-config-general.png">icons/monochrome/veyon-config-general.png</file>
        <file alias="scalable/veyon-config-service.png">icons/monochrome/veyon-config-service.png</file>
        <file alias="scalable/veyon-config-master.png">icons/monochrome/veyon-config-master.png</file>
        <file alias="scalable/veyon-config-access-control.png">icons/monochrome/veyon-config-access-control.png</file>
    </qresource>
    <qresource prefix="/icons/veyon-monochrome-dark">
        <file alias="scalable/veyon-config-general.png">icons/monochrome-dark/veyon-config-general.png</file>
        <file alias="scalable/veyon-config-service.png">icons/monochrome-dark/veyon-config-service.png</file>
        <file alias="scalable/veyon-config-master.png">icons/monochrome-dark/veyon-config-master.png</file>
        <file alias="scalable/veyon-config-access-control.png">icons/monochrome-dark/veyon-config-access-control.png</file>
